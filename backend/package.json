{
   "name": "backend",
   "private": true,
   "version": "1.0.0",
   "type": "commonjs",
   "main": "index.js",
   "scripts": {
      "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/server-auth.ts",
      "start": "cross-env NODE_ENV=production node dist/server-auth.js",
      "build": "tsc && prisma generate",
      "build:lambda": "tsc && npx prisma generate",
      "start:lambda": "node dist/lambda.js",
      "deploy": "npm run build:lambda && serverless deploy",
      "deploy:dev": "npm run build:lambda && serverless deploy --stage dev",
      "deploy:prod": "npm run build:lambda && serverless deploy --stage prod",
      "offline": "serverless offline",
      "prisma:generate": "prisma generate",
      "prisma:migrate": "prisma migrate dev"
   },
   "keywords": [],
   "author": "",
   "license": "ISC",
   "dependencies": {
      "@prisma/client": "^6.15.0",
      "@types/express-rate-limit": "^6.0.2",
      "@types/pg": "^8.15.5",
      "bcryptjs": "^3.0.2",
      "cors": "^2.8.5",
      "express": "^5.1.0",
      "express-rate-limit": "^8.1.0",
      "helmet": "^8.1.0",
      "jsonwebtoken": "^9.0.2",
      "mysql2": "^3.14.4",
      "pg": "^8.16.3",
      "serverless-http": "^4.0.0"
   },
   "devDependencies": {
      "@types/aws-lambda": "^8.10.152",
      "@types/cors": "^2.8.19",
      "@types/express": "^5.0.3",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/node": "^24.3.1",
      "cross-env": "^10.0.0",
      "prisma": "^6.15.0",
      "serverless": "^4.18.2",
      "serverless-offline": "^14.4.0",
      "serverless-plugin-optimize": "^4.2.1-rc.1",
      "serverless-webpack": "^5.15.3",
      "ts-loader": "^9.5.4",
      "ts-node": "^10.9.2",
      "ts-node-dev": "^2.0.0",
      "typescript": "^5.9.2",
      "webpack": "^5.101.3",
      "webpack-cli": "^6.0.1"
   }
}
