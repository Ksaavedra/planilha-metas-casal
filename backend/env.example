# Configurações de Desenvolvimento
NODE_ENV=development
PORT=3000

# Database - MySQL Local (Docker) / RDS AWS
# Local: mysql://root:password@localhost:3306/planilha_organizacao_deva # RDS: mysql://admin:_gxeF8*P1-a*bQ|gv4W(z!X3gtTZ@myapp-mysql-dev.c16kosqkuklw.sa-east-1.rds.amazonaws.com:3306/planilha_organizacao
DATABASE_URL="mysql://root:password@localhost:3306/planilha_organizacao_dev"

# JWT
JWT_SECRET="dev-secret-key-change-in-production-2025"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:4200"
FRONTEND_URL="http://localhost:4200"

# Security
BCRYPT_ROUNDS=10
ENABLE_HELMET=true
ENABLE_CORS=true
ENABLE_RATE_LIMIT=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="debug"
