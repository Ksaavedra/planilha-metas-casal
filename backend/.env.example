# Copie este arquivo para .env e preencha os valores.
# Sem SMTP_HOST, SMTP_USER e SMTP_PASS o código de recuperação só aparece no terminal do backend.

# Gmail: use uma "Senha de app" (exige verificação em duas etapas), não a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ORBIS <seu-email@gmail.com>"

# Quem recebe os feedbacks enviados pelos usuários (vazio = kellymichelesaavedra@gmail.com).
CONTACT_MAIL_TO=
