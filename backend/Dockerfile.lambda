# Dockerfile otimizado para Lambda
FROM node:18-alpine

WORKDIR /app

# Instalar dependências do sistema
RUN apk add --no-cache zip

# Copiar package.json e package-lock.json
COPY package*.json ./

# Instalar dependências de produção
RUN npm ci --only=production --silent

# Copiar código fonte
COPY . .

# Gerar Prisma Client para Linux
RUN npx prisma generate

# Build TypeScript
RUN npm run build

# Remover arquivos desnecessários para reduzir tamanho
RUN rm -rf node_modules/.cache
RUN rm -rf node_modules/@prisma/engines
RUN rm -rf prisma/migrations
RUN rm -rf *.md
RUN rm -rf scripts
RUN rm -rf *.ps1
RUN rm -rf *.sh
RUN rm -rf .env*
RUN rm -rf config.env
RUN rm -rf docker-compose.yml
RUN rm -rf Dockerfile*

# Criar pacote final otimizado
RUN zip -r lambda-package.zip . -x "*.git*" "*.docker*" "Dockerfile*" "node_modules/.cache/*"

# Mostrar tamanho do pacote
RUN ls -lh lambda-package.zip

CMD ["cat", "lambda-package.zip"]
